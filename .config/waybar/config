{
  "layer": "bottom",
  "position": "up",
  "height": 30,
  "reload_style_on_change": true,
  "modules-left": [ "hyprland/workspaces", "hyprland/language"],
  "modules-center": ["custom/lyrics"],
  "modules-right": ["group/tray-drawer", "cpu", "custom/gpu", "memory", "pulseaudio", "clock"],

  "custom/lyrics": {
    "format": "{icon} {0}",
    "return-type": "json",
    "max-length": 60,
    "hide-empty-text": true,
    "format-icons": {
      "playing": "",
      "paused": "",
      "lyric": "",
      "music": "󰝚",
      "no_lyric": "",
      "getting": ""
    },
    "exec-if": "which waybar-lyric",
    "exec": "waybar-lyric --quiet",
    "on-click": "waybar-lyric play-pause",
    "on-scroll-up": "waybar-lyric next",
    "on-scroll-down": "waybar-lyric previous"
  },

"network": {
    "interface": "wlp0s20f3",
    "format": "{ifname}",
    "format-wifi": "{essid}",
    "format-disconnected": " - ",
    "tooltip-format": "{ifname}",
    "tooltip-format-wifi": "{essid}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50
},

"group/tray-drawer": {
    "orientation": "inherit",
    "drawer": {
        "transition-duration": 500,
        "children-class": "tray-child",
        "transition-left-to-right": false,
        "click-to-reveal": false
    },
    "modules": [
        "custom/tray-toggle",
        "tray"
    ]
},

"custom/tray-toggle": {
    "format": "",
    "tooltip": false
},

"tray": {
    "spacing": 12
},

"pulseaudio": {
    "format": "{icon} {volume}%",
    "format-bluetooth": "{icon} {volume}%",
    "format-muted": "  {volume}%",
    "format-icons": {
        "headphone": "",
        "hands-free": "",
        "headset": "",
        "phone": "",
        "portable": "",
        "car": "",
        "default": ["", "", ""]
    },
    "scroll-step": 5.0,
    "on-click": "pavucontrol -t 3",
    "tooltip-format": "{icon} {desc} | {volume}%",
    "smooth-scrolling-threshold": 1
},

"battery": {
    "bat":"BAT0",
    "states": {
        "good": 95,
        "warning": 30,
        "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "+{capacity}%",
    "format-plugged": "B:{capacity}%",
    "format-alt": "B:{time} ",
    "format-icons": ["▁", "▃", "▄", "▆", "█"]
},

"hyprland/language": { "format-en": "US", "format-ru": "RU" },

"hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "all-outputs": false,
    "active-only": false,
    "show-empty": false
},
   
"hyprland/window": {
    "format": "{title}",
    "max-length": 80,
    "separate-outputs": true
},

"cpu": {
    "interval": 2,
    "format": " {usage}%"
},

"custom/gpu": {
    "interval": 2,
    "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
    "format": "󰢮 {}%"
},

"power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
        "default": "def",
        "performance": "perf",
        "balanced": "norm",
        "power-saver": "save"
    }
},

"clock": {
    "format-alt": "{:%a}-{:%d} | {:%I}:{:%M}",
    "format": "{:%a-%d | %I:%M}",
    "timezones": [ "Europe/Moscow" ],
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
        "mode": "month",
        "mode-mon-col": 3,
        "on-scroll": 1,
        "format": {
            "months": "<span color='#a6e3a1'><b>{}</b></span>",
            "days": "<span color='#cdd6f4'>{}</span>",
            "weeks": "<span color='#74c7ec'><b>W{}</b></span>",
            "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
            "today": "<span background='#f38ba8' color='#1e1e2e'><b>{}</b></span>"
        }
    },
    "actions": {
        "on-click": "tz_up",
        "on-click-right": "tz_down",
        "on-click-forward": "shift_up",
        "on-click-backward": "shift_down",
        "on-click-middle": "mode"
    }
},

"memory": {
    "interval": 5,
    "format": " {used:0.1f}G",
    "format-alt-click": "click"
}
}
